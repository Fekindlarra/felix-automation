# FASE 14 Week 2: Track C - Alert Routing Configuration
# Copy this to .env and fill in your actual values

# ============================================================================
# SLACK INTEGRATION
# ============================================================================

# Get webhook URL from: https://api.slack.com/messaging/webhooks
# Format: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# Main alert webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Channel-specific webhooks (optional, for more control)
SLACK_CRITICAL_WEBHOOK=https://hooks.slack.com/services/YOUR/CRITICAL/URL
SLACK_WEBSOCKET_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBSOCKET/URL
SLACK_API_WEBHOOK=https://hooks.slack.com/services/YOUR/API/URL
SLACK_CACHE_WEBHOOK=https://hooks.slack.com/services/YOUR/CACHE/URL

# ============================================================================
# PAGERDUTY INTEGRATION
# ============================================================================

# Get Integration Key from:
# 1. Go to PagerDuty dashboard
# 2. Create Service or select existing
# 3. Go to Integrations tab
# 4. Add "Prometheus" or "Custom Event Rule"
# 5. Copy Integration Key

# Main PagerDuty service key
PAGERDUTY_SERVICE_KEY=YOUR_PAGERDUTY_SERVICE_KEY

# Component-specific service keys (optional)
PAGERDUTY_CRITICAL_KEY=PAGERDUTY_KEY_CRITICAL
PAGERDUTY_WEBSOCKET_KEY=PAGERDUTY_KEY_WEBSOCKET
PAGERDUTY_SYSTEM_KEY=PAGERDUTY_KEY_SYSTEM

# PagerDuty API (for incident management)
PAGERDUTY_API_KEY=YOUR_PAGERDUTY_API_KEY
PAGERDUTY_API_URL=https://api.pagerduty.com

# ============================================================================
# EMAIL CONFIGURATION (via SendGrid)
# ============================================================================

# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY

# Email from address (must be verified in SendGrid)
ALERT_EMAIL_FROM=alerts@enbuenamesa.com

# Recipient emails
ALERT_EMAIL_CRITICAL=critical-alerts@enbuenamesa.com
ALERT_EMAIL_API=api-team@enbuenamesa.com
ALERT_EMAIL_WEBSOCKET=websocket-team@enbuenamesa.com

# ============================================================================
# GENERAL ALERT CONFIGURATION
# ============================================================================

# AlertManager settings
ALERTMANAGER_URL=http://localhost:9093
ALERTMANAGER_RESOLVE_TIMEOUT=5m

# Alert grouping
ALERT_GROUP_WAIT=10s          # Wait time before sending group
ALERT_GROUP_INTERVAL=10s      # Regroup interval
ALERT_REPEAT_INTERVAL=12h     # How long to wait before resendig

# Notification settings
ALERT_SEND_RESOLVED=true      # Send notification when alert resolves
ALERT_INCLUDE_DESCRIPTION=true # Include full alert description in notifications

# ============================================================================
# WEBHOOK CONFIGURATION (for custom handlers)
# ============================================================================

# Webhook URLs that AlertManager will call
WEBHOOK_ALERTMANAGER_URL=http://localhost:8000/webhooks/alertmanager
WEBHOOK_SLACK_URL=http://localhost:8000/webhooks/slack
WEBHOOK_PAGERDUTY_URL=http://localhost:8000/webhooks/pagerduty

# Webhook secrets (for validation)
WEBHOOK_SECRET=your-secret-key-for-validating-webhooks

# ============================================================================
# ALERT ROUTING RULES (JSON format, or load from database)
# ============================================================================

# Example route for critical alerts:
# {
#   "match_labels": {"severity": "critical"},
#   "receiver": "critical-team",
#   "group_wait": "0s",
#   "group_interval": "5s"
# }

ALERT_ROUTING_CONFIG_PATH=./alert_routing_config.json

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
ALERT_ROUTING_LOG_LEVEL=INFO

# Enable webhook debugging (logs all incoming webhooks)
ALERT_ROUTING_DEBUG_WEBHOOKS=false

# ============================================================================
# INSTRUCTIONS FOR SETUP
# ============================================================================

# 1. SLACK SETUP:
#    - Create Slack workspace or use existing
#    - Create channels: #felix-alerts-critical, #felix-alerts-warnings, etc.
#    - Go to https://api.slack.com/messaging/webhooks
#    - Click "Create New App" > "From scratch"
#    - Enable Incoming Webhooks
#    - Add webhook for each channel
#    - Copy webhook URLs below SLACK_WEBHOOK_URL

# 2. PAGERDUTY SETUP:
#    - Sign up at https://www.pagerduty.com or use existing
#    - Create a service for "Felix Automation"
#    - Go to Integrations > Add Integration
#    - Select "Prometheus" or "Custom Event Rule"
#    - Copy Integration Key below PAGERDUTY_SERVICE_KEY

# 3. SENDGRID SETUP:
#    - Sign up at https://sendgrid.com or use existing
#    - Go to Settings > API Keys
#    - Create new API key
#    - Copy key below SENDGRID_API_KEY
#    - Verify sender email address in SendGrid settings

# 4. ALERTMANAGER SETUP:
#    - Update docker-compose.prometheus-grafana.yml to mount alertmanager.yml
#    - Restart AlertManager: docker-compose restart alertmanager
#    - Verify: curl http://localhost:9093/api/v1/status

# 5. TEST:
#    - Trigger a test alert in Prometheus
#    - Verify notification in Slack
#    - Check PagerDuty incident created
#    - Check email received

# ============================================================================
# SECURITY NOTES
# ============================================================================

# NEVER commit this file with real values to Git!
# Use .gitignore to exclude .env files
# Store sensitive values in:
#   - Environment variables
#   - Secure secret management (AWS Secrets Manager, Vault, etc.)
#   - Docker secrets (for production)

# Example .gitignore entry:
# .env
# .env.local
# .env.*.local

# ============================================================================
