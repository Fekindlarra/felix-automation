# Felix Automation Production Environment Configuration
# FASE 14 - Real-Time & ML Features
# Generated: October 6, 2024

# ============================================================================
# ENVIRONMENT & DEPLOYMENT
# ============================================================================
FLASK_ENV=production
LOG_LEVEL=INFO
DEBUG=False
ENVIRONMENT=production

# ============================================================================
# DATABASE (PostgreSQL 15+)
# ============================================================================
DATABASE_URL=postgresql://felix_user:${DB_PASSWORD}@db:5432/felix_automation
DB_USER=felix_user
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_32_CHARS_MIN
DB_HOST=db
DB_PORT=5432
DB_NAME=felix_automation
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600
DB_ECHO=False

# ============================================================================
# CACHE & SESSION STORE (Redis 7+)
# ============================================================================
REDIS_URL=redis://:${REDIS_PASSWORD}@cache:6379/0
REDIS_PASSWORD=CHANGE_ME_SECURE_PASSWORD_32_CHARS_MIN
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_DB=0

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
JWT_SECRET=CHANGE_ME_SECURE_SECRET_64_CHARS_MIN_USE_OPENSSL_RAND_HEX
JWT_ALGORITHM=HS256
JWT_EXPIRY=86400
SECRET_KEY=CHANGE_ME_SECURE_SECRET_64_CHARS_MIN

# CORS Configuration
CORS_ORIGINS=https://enbuenamesa.com,https://api.enbuenamesa.com,https://admin.enbuenamesa.com
CORS_ALLOW_CREDENTIALS=True

# ============================================================================
# EXTERNAL INTEGRATIONS
# ============================================================================

# SendGrid Email Service
SENDGRID_API_KEY=SG.CHANGE_ME_REAL_KEY_FROM_SENDGRID
SENDGRID_FROM_EMAIL=noreply@enbuenamesa.com
SENDGRID_FROM_NAME="Felix Automation"

# Shopify Integration
SHOPIFY_API_KEY=CHANGE_ME_FROM_SHOPIFY_APP
SHOPIFY_API_SECRET=CHANGE_ME_FROM_SHOPIFY_APP
SHOPIFY_API_VERSION=2024-01

# Facebook Ads Integration
FACEBOOK_ACCESS_TOKEN=CHANGE_ME_FROM_FACEBOOK_GRAPH_API
FACEBOOK_BUSINESS_ACCOUNT_ID=CHANGE_ME_NUMERIC_ID

# Google Ads Integration
GOOGLE_ADS_DEVELOPER_TOKEN=CHANGE_ME_FROM_GOOGLE_ADS
GOOGLE_ADS_CLIENT_ID=CHANGE_ME_FROM_OAUTH
GOOGLE_ADS_CLIENT_SECRET=CHANGE_ME_FROM_OAUTH

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Datadog
DATADOG_API_KEY=CHANGE_ME_FROM_DATADOG
DATADOG_ENV=production
DATADOG_TRACE_ENABLED=True

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME_REAL_WEBHOOK
SLACK_BOT_TOKEN=xoxb-CHANGE_ME_FROM_SLACK

# Email Alerts
ALERTS_EMAIL_LIST=ops@enbuenamesa.com,devops@enbuenamesa.com
ALERT_THRESHOLD_ERROR_RATE=0.05
ALERT_THRESHOLD_RESPONSE_TIME=2000

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_WEBSOCKET_REAL_TIME=True
ENABLE_ML_PREDICTIONS=True
ENABLE_AB_TESTING=True
ENABLE_SHOPIFY_WEBHOOKS=True
ENABLE_EMAIL_TRACKING=True

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_HEARTBEAT_INTERVAL_MOBILE=60
CACHE_REDIS_TTL=3600
DATABASE_QUERY_TIMEOUT=30

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_API_REQUESTS_PER_SECOND=10
RATE_LIMIT_WEBSOCKET_CONNECTIONS=100
RATE_LIMIT_EMAIL_SENDS_PER_MINUTE=60

# ============================================================================
# FILE UPLOAD & STORAGE
# ============================================================================
MAX_UPLOAD_SIZE=20971520  # 20MB in bytes
UPLOAD_FOLDER=/app/uploads
ALLOWED_UPLOAD_EXTENSIONS=pdf,xlsx,csv,json

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups

# ============================================================================
# SSL/TLS CERTIFICATES
# ============================================================================
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
FORCE_HTTPS=True

# ============================================================================
# COMPLIANCE & SECURITY
# ============================================================================
ENABLE_AUDIT_LOGGING=True
ENABLE_RATE_LIMITING=True
ENABLE_CORS=True
CORS_ALLOW_HEADERS=Content-Type,Authorization
SECURE_COOKIES=True
HTTPONLY_COOKIES=True
SAMESITE_COOKIES=Strict

# ============================================================================
# FEATURE CONFIGURATION - TRACK D: REAL-TIME ALERTS
# ============================================================================
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY=60
WEBHOOK_TIMEOUT=30
ALERT_PROCESSING_BATCH_SIZE=50
ALERT_RETENTION_DAYS=90

# ============================================================================
# FEATURE CONFIGURATION - TRACK E: MOBILE OPTIMIZATION
# ============================================================================
SERVICE_WORKER_CACHE_STRATEGY=network-first
PWA_INSTALLABLE=True
MOBILE_HEARTBEAT_OPTIMIZATION=True
OFFLINE_CAPABILITY=True

# ============================================================================
# NOTES
# ============================================================================
# - All CHANGE_ME values MUST be configured before deployment
# - Never commit real secrets to version control
# - Use AWS Secrets Manager or HashiCorp Vault for secret management
# - Rotate secrets monthly
# - Enable MFA for all external service accounts
# - Review CORS_ORIGINS for your specific domain
# - Adjust GUNICORN_WORKERS based on CPU cores (CPU_COUNT * 2 + 1)
